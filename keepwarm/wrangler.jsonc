{
  "name": "flexed-keepwarm",
  "main": "src/index.js",
  "compatibility_date": "2026-06-08",

  // Every 10 minutes, 12:00-20:59 UTC, Monday through Friday.
  // That is 7am-4pm US Central — the school day, not evening planning time.
  // A single expression is enough here (unlike the old evening window): this
  // one doesn't cross midnight UTC, so there's no wraparound to split across
  // two cron lines.
  //
  // UTC offset assumes US Central is on daylight time (UTC-5); it drifts an
  // hour during standard time (UTC-6, roughly Nov-Mar), same simplification
  // the old evening window made — not worth a DST-aware cron for a keepwarm
  // ping a few minutes early or late.
  "triggers": {
    "crons": ["*/10 12-20 * * 1-5"]
  },

  "vars": {
    // Replace with the Render URL once the service exists.
    "APP_URL": "https://flexed-academy-backend.onrender.com"
  },

  "observability": { "enabled": true }
}
