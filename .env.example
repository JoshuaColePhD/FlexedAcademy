# Copy to .env and fill in. Only OPENAI_API_KEY is required.
#
# (This file used to say ANTHROPIC_API_KEY, which no code path has ever read.)

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# --- paths (all optional; defaults shown in comments) -----------------------

# Application database. Default: ~/Library/Application Support/ap-lang-rag/app.db
# Deliberately OUTSIDE this repo: the repo lives in Google Drive, and SQLite's WAL
# sidecars (-wal, -shm) must stay consistent with the main file. Drive uploads
# them independently and makes "app.db (1)" on conflict. This holds the only
# irreplaceable data in the project, so keep it out of the synced tree.
APP_DB_PATH=""

# Generated .docx output. Default: <repo>/plans
# These are fine in Drive — written once, then read, so syncing them is the point.
PLANS_DIR=""

# Auth. REQUIRE_LOGIN=false makes every unauthenticated request share one
# account and its data — a local-iteration escape hatch only. COOKIE_SECURE
# marks the session cookie Secure so a browser only ever sends it over HTTPS;
# leave it false locally (http://127.0.0.1 would never receive a Secure cookie)
# and set it true anywhere behind TLS. render.yaml does.
REQUIRE_LOGIN="true"
COOKIE_SECURE="false"

# Signs the session cookie. A shared deployment MUST set this, or every restart
# generates a new key and logs everyone out — and the default is public.
SESSION_SECRET=""

# Google sign-in. Vite inlines VITE_GOOGLE_CLIENT_ID at BUILD time, so it has to
# be present before `npm run build`, not merely at boot.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# "Share via Google" (backend/google_drive.py, routes/drive.py) — a separate,
# bigger ask of the same Google Cloud project than sign-in above: a real OAuth
# client that can create and permission a Drive file, not just verify identity.
# Requires the Drive API enabled on that project and (for a school Google
# Workspace domain) may need that domain's admin to approve the app. Both
# empty = drive_share_enabled is False and the feature stays fully inert.
GOOGLE_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on that OAuth client in Google
# Cloud Console. Empty = derive from the incoming request, same fallback
# BILLING_RETURN_URL uses — fine for local dev, set explicitly in production.
DRIVE_REDIRECT_URL=""

# The canonical Florence City Schools template builder. Lives outside this repo,
# shared with the build-lesson-plan skill. Do not fork it — the app asserts its
# contract at startup instead.
# Default: <Iris_OS>/Skills/build-lesson-plan/scripts/build_lesson_plan.py
BUILDER_PATH=""

# Curated pedagogy context injected into the prompt.
# Default: backend/context/ap_lang_rules.md
SKILL_CONTEXT_PATH=""

# --- retrieval --------------------------------------------------------------

RETRIEVAL_TOP_K="5"

# Relevance floor. Anything further than this is treated as ungrounded and the
# request is refused rather than answered from adjacent standards.
#
# Tuned empirically for all-MiniLM-L6-v2 + Chroma's default L2 space:
# in-domain queries top out at 0.73, off-domain starts at 0.82. THIS NUMBER IS
# MEANINGLESS if the embedding model or the chunking changes — re-run
# scripts/06_threshold_sweep.py and update it.
RETRIEVAL_MAX_DISTANCE="0.78"

# Per-course floor overrides, as JSON, e.g. RETRIEVAL_FLOORS='{"Math": 0.62}'
#
# The 0.78 above was measured against AP Lang and does NOT transfer to every
# Alabama framework. On the grade 9-12 corpus (2026-08-04) Math rejects off-domain
# input only past 0.746, Science past 0.752 and PE past 0.762 — so at 0.78 all
# three will ground irrelevant requests instead of refusing them. AP Lang and ELA
# are clear by ~0.35.
#
# Left empty on purpose — measure, don't guess:
#   python scripts/06_threshold_sweep.py --course Math --grade 11
# then put the number here. See source_docs/KNOWN_GAPS.md.
RETRIEVAL_FLOORS=""

# Below this many surviving standards, the generator is told to say so rather than
# fill the week in from memory.
RETRIEVAL_THIN_THRESHOLD="3"

# --- server -----------------------------------------------------------------

# Only needed if you don't use the Vite dev proxy (see frontend/vite.config.js).
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
API_PORT="8010"
# (8000 is used by the local oMLX server on this machine.)
LOG_LEVEL="INFO"

# Signs the login session cookie (backend/auth.py). REQUIRED for any shared
# deployment — the server logs a warning at boot and runs with a well-known
# insecure default if this is left blank, which lets anyone forge any
# teacher's session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=""
