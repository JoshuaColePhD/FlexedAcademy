#!/bin/sh
# Keep Obsidian's repository map current after every FlexEd commit.
# This exports metadata and commit subjects only; it never copies source code.

REPO_ROOT=$(git rev-parse --show-toplevel)
IRIS_ROOT=$(cd "$REPO_ROOT/../.." && pwd)
python3 "$IRIS_ROOT/Scripts/sync_iris_obsidian.py" \
  --repo "$REPO_ROOT" \
  --project flexed-academy \
  --auto-commit-event
