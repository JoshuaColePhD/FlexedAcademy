# Python environment
venv/
__pycache__/
*.pyc

# Secrets — never commit
.env

# Vector store (rebuildable from source_docs via scripts/02_embed_store.py)
chroma_db/

# Local model cache
.cache/

# macOS
.DS_Store

# Node
node_modules/

# Application database (lives outside the repo by default; ignored in case
# APP_DB_PATH is ever pointed in here). SQLite WAL sidecars must never sync.
*.db
*.db-wal
*.db-shm

# Generated lesson plans — the .docx output dir. Rebuildable from plans.plan_json.
plans/

# Scratch. temp/ is no longer a store as of the 2026-08-04 refactor; kept
# ignored so any stragglers don't get committed.
temp/

# Stray CLI output at the repo root
/Lesson_Plan.docx

# Redundant duplicate of source_docs/ that still contains the AI-contaminated
# act-english-standards.md (byte-identical to source_docs/quarantine/…
# CONTAMINATED.md). Not parsed by anything. Left untracked deliberately so the
# quarantine decision in source_docs/SPOT_CHECK_step1.md isn't undone by a
# commit. Delete it once confirmed it holds nothing unique.
AP_LANG_RAG/

# Drifted local copy of the build-lesson-plan skill. The canonical one lives at
# Iris_OS/Skills/build-lesson-plan/ and is what BUILDER_PATH points to.
build-lesson-plan/

# Generated standards chunk files. Regenerable, and big enough to matter in a
# Google-Drive-synced repo: alcos_chunks.json alone is ~29MB and would be
# rewritten wholesale on every ingest.
#
#   act_chunks.json    <- scripts/01b_ingest_act_standards.py  (network: ACT sheet)
#   alcos_chunks.json  <- scripts/01d_ingest_alcos_case.py     (offline: source_docs/case/)
#
# chunks.json stays TRACKED: it is ~190KB and is the hand-audited AP Lang parse
# whose spot check is recorded in source_docs/SPOT_CHECK_step1.md.
#
# source_docs/case/ also stays tracked (~15MB), because it is the authoritative
# input that pins these to the exact ALSDE CASE packages verified on 2026-08-04.
# Keeping it means the whole corpus rebuilds offline and identically even if the
# state changes or withdraws the feed.
act_chunks.json
alcos_chunks.json
